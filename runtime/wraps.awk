# wraps.awk: build/wraps.c from the generated code. For each address in wraps.txt (a hex address a
# line, # comments), the generated function f_<address> again as orig_f_<address>, an ordinary
# function the runtime's replacement of f_<address> calls (the generated one is weak and gives way
# to the replacement). Copied at build time from GEN, which is never committed: the game's code
# stays out of the repository.
#
#   awk -f wraps.awk wraps.txt $(GEN)/code_*.c > build/wraps.c

FNR == NR {
    sub(/#.*/, "")
    gsub(/[ \t\r]/, "")
    a = toupper($0)
    while (a != "" && length(a) < 8) a = "0" a  # as the generated names have them: f_000410E0
    if (a != "") want["f_" a] = 1
    next
}
FNR == 1 && !started {
    print "/* Generated by wraps.awk from the recompiled code: do not edit. */"
    print "#include \"funcs.h\""
    started = 1
}
/^XB_WEAK void f_[0-9A-F]+\(XbCtx \*c\) \{/ {
    name = $3
    sub(/\(.*/, "", name)
    if (name in want) {
        copying = 1
        line = $0
        sub(/^XB_WEAK void f_/, "void orig_f_", line)
        print line
        found[name] = 1
        next
    }
}
copying {
    print
    if ($0 ~ /^}/) copying = 0
}
END {
    for (n in want)
        if (!(n in found)) {
            print "wraps.awk: " n " not found in the generated code" > "/dev/stderr"
            exit 1
        }
}
